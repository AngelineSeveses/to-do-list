rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    function isValidId(id) {
      return id is string && id.size() >= 1 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidPriority(priority) {
      return priority is string && priority in ['LOW', 'MEDIUM', 'HIGH'];
    }

    function isValidCategory(category) {
      return category is string && category in ['PERSONAL', 'WORK', 'ERRANDS', 'HEALTH', 'GENERAL'];
    }

    function isValidTask(data, userId) {
      return data.userId is string &&
             data.userId == userId &&
             data.userId.size() >= 1 &&
             data.userId.size() <= 128 &&
             data.title is string &&
             data.title.size() >= 1 &&
             data.title.size() <= 120 &&
             data.notes is string &&
             data.notes.size() <= 500 &&
             data.completed is bool &&
             isValidPriority(data.priority) &&
             isValidCategory(data.category) &&
             data.dueAtMillis is int &&
             data.dueAtMillis >= 0 &&
             data.createdAt is timestamp &&
             data.createdAt <= request.time &&
             data.updatedAt is timestamp &&
             data.updatedAt <= request.time;
    }

    match /users/{userId}/tasks/{taskId} {
      allow get: if isOwner(userId) && isValidId(taskId);
      allow list: if isOwner(userId);

      allow create: if isOwner(userId) &&
                       isValidId(taskId) &&
                       incoming().keys().hasAll([
                         'userId',
                         'title',
                         'notes',
                         'completed',
                         'priority',
                         'category',
                         'dueAtMillis',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       incoming().keys().hasOnly([
                         'userId',
                         'title',
                         'notes',
                         'completed',
                         'priority',
                         'category',
                         'dueAtMillis',
                         'createdAt',
                         'updatedAt'
                       ]) &&
                       isValidTask(incoming(), userId);

      allow update: if isOwner(userId) &&
                       isValidId(taskId) &&
                       isValidTask(incoming(), userId) &&
                       incoming().userId == existing().userId &&
                       incoming().createdAt == existing().createdAt &&
                       (
                         incoming().diff(existing()).affectedKeys().hasOnly(['completed', 'updatedAt']) ||
                         incoming().diff(existing()).affectedKeys().hasOnly([
                           'title',
                           'notes',
                           'completed',
                           'priority',
                           'category',
                           'dueAtMillis',
                           'updatedAt'
                         ])
                       );

      allow delete: if isOwner(userId) && isValidId(taskId);
    }
  }
}
